{
  "permissions": {
    "defaultMode": "plan"
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/session-start-git-check.sh",
            "timeout": 15,
            "statusMessage": "Checking git sync status with origin/main..."
          }
        ]
      }
    ]
  }
}
